#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

profile="${1:-quick}"
case "$profile" in
  quick|model|auth-model|auth-findings|kontrol|target-test|full) ;;
  *)
    echo "usage: $0 [quick|model|auth-model|auth-findings|kontrol|target-test|full]" >&2
    exit 64
    ;;
esac

if ! ./scripts/doctor; then
  exit 1
fi

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
run_dir="$ROOT/results/$run_id"
mkdir -p "$run_dir"
manifest="$run_dir/manifest.txt"

failures=0
skips=0
unknowns=0
auth_api_repository="$(python3 -c 'import json; print(json.load(open("verification/auth-source.lock.json"))["repository"])')"
auth_api_branch="$(python3 -c 'import json; print(json.load(open("verification/auth-source.lock.json"))["branch"])')"
auth_api_commit="$(python3 -c 'import json; print(json.load(open("verification/auth-source.lock.json"))["commit"])')"

{
  echo "profile=$profile"
  echo "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "harness_commit=$(git rev-parse HEAD 2>/dev/null || echo uncommitted)"
  echo "target_commit=$(git -C vendor/mynawallet-sc rev-parse HEAD)"
  echo "target_describe=$(git -C vendor/mynawallet-sc describe --always --dirty)"
  echo "auth_api_repository=$auth_api_repository"
  echo "auth_api_branch=$auth_api_branch"
  echo "auth_api_commit=$auth_api_commit"
  echo "node=$(node --version)"
  echo "npm=$(npm --version)"
  echo "python=$(python3 --version 2>&1)"
  echo "uv=$(uv --version)"
  echo "forge=$(forge --version | head -1)"
  echo "solc=$(.tooling/bin/solc-0.8.26 --version | tail -1)"
  echo "quint=$(node_modules/.bin/quint --version 2>/dev/null | head -1)"
  if command -v kontrol >/dev/null 2>&1; then
    echo "kontrol=$(kontrol --version 2>/dev/null | head -1)"
  elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo "kontrol=$(./scripts/kontrol-run version 2>/dev/null | head -1) (Docker)"
  else
    echo "kontrol=MISSING"
  fi
  echo
} > "$manifest"

run_stage() {
  local name="$1"
  shift
  local log="$run_dir/$name.log"

  printf 'RUN  %-24s' "$name"
  printf ' %q' "$@"
  printf '\n'

  {
    printf 'command:'
    printf ' %q' "$@"
    printf '\n\n'
  } > "$log"

  "$@" >> "$log" 2>&1
  local code=$?
  if (( code == 0 )); then
    echo "PASS $name" | tee -a "$manifest"
  else
    echo "FAIL $name exit=$code log=${log#$ROOT/}" | tee -a "$manifest"
    failures=$((failures + 1))
  fi
}

skip_stage() {
  local name="$1"
  shift
  echo "SKIP $name reason=$*" | tee -a "$manifest"
  skips=$((skips + 1))
}

run_property_check() {
  local name="$1"
  shift
  local log="$run_dir/$name.log"

  printf 'RUN  %-24s' "$name"
  printf ' %q' "$@"
  printf '\n'

  {
    printf 'command:'
    printf ' %q' "$@"
    printf '\n\n'
  } > "$log"

  "$@" >> "$log" 2>&1
  local code=$?
  if (( code == 0 )); then
    echo "PASS $name" | tee -a "$manifest"
  elif grep -q "found a counterexample" "$log"; then
    echo "FAIL $name counterexample log=${log#$ROOT/}" | tee -a "$manifest"
    failures=$((failures + 1))
  else
    echo "UNKNOWN $name exit=$code log=${log#$ROOT/}" | tee -a "$manifest"
    unknowns=$((unknowns + 1))
  fi
}

run_auth_model() {
  run_stage auth-model-typecheck npm run model:auth:typecheck
  run_stage auth-model-tests npm run model:auth:test
  run_property_check auth-registration-tlc timeout 15m npm run model:auth:verify:registration
  run_property_check auth-login-tlc timeout 15m npm run model:auth:verify:login
  run_property_check auth-session-tlc timeout 15m npm run model:auth:verify:session
}

run_auth_findings() {
  run_property_check auth-reg-challenge-single-use timeout 15m node_modules/.bin/quint verify --backend=tlc --main=AuthRegistration --invariant=registrationChallengeSingleUse models/quint/AuthLifecycle.qnt
  run_property_check auth-immediate-access-revoke timeout 15m node_modules/.bin/quint verify --backend=tlc --main=AuthSession --invariant=immediateAccessInvalidation models/quint/AuthLifecycle.qnt
}

run_model() {
  run_stage recovery-model-typecheck npm run model:recovery:typecheck
  run_stage recovery-model-tests npm run model:recovery:test
  run_property_check recovery-model-tlc npm run model:recovery:verify
  run_auth_model
}

run_solidity_build() {
  run_stage solidity-harness-build bash -lc 'cd verification/solidity && forge build'
}

run_kontrol() {
  if command -v kontrol >/dev/null 2>&1 || { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }; then
    run_stage kontrol-build ./scripts/kontrol-run build -O0
    run_stage kontrol-hash-canonical ./scripts/kontrol-run prove --match-test RecoveryHashProperties.test_hashMatchesCanonicalEncoding
  else
    skip_stage kontrol "neither Kontrol v1.0.255 nor a running Docker daemon is available"
  fi
}

run_target_test() {
  run_stage target-cross-chain-e2e bash -lc 'cd vendor/mynawallet-sc && forge test --match-path test/integration/recovery/CrossChainRecoveryE2EFlow.t.sol -vv'
}

case "$profile" in
  quick)
    run_stage model-typecheck npm run model:typecheck
    run_stage model-tests npm run model:test
    run_solidity_build
    ;;
  model) run_model ;;
  auth-model) run_auth_model ;;
  auth-findings) run_auth_findings ;;
  kontrol) run_kontrol ;;
  target-test) run_target_test ;;
  full)
    run_model
    run_kontrol
    run_target_test
    ;;
esac

{
  echo
  echo "finished_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "failures=$failures"
  echo "skips=$skips"
  echo "unknowns=$unknowns"
} >> "$manifest"

echo "evidence: ${run_dir#$ROOT/}"
if (( failures > 0 || unknowns > 0 )); then
  exit 1
fi
