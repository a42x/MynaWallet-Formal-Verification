#!/usr/bin/env bash
set -euo pipefail

IMAGE="runtimeverificationinc/kontrol@sha256:858f004144d61b005997f56bb8b7cd15673850286c96e0e5ec0502d9c9a9e204"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required for the pinned Kontrol image." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker daemon is not running." >&2
  exit 1
fi

docker pull --platform linux/amd64 "$IMAGE"
docker run --rm --platform linux/amd64 "$IMAGE" kontrol version
